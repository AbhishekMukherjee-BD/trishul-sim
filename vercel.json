{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/portal.html",
      "destination": "/portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
